---
import type { Paper, Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import PaperCard from '../react/PaperCard';

export interface DateGroup {
  /** i18n key for the label (e.g. 'thisWeek') */
  labelKey: string;
  papers: Paper[];
}

export interface Props {
  periods: DateGroup[];
  lang: Lang;
}

const { periods, lang } = Astro.props;
---

<section class="mb-16">
  <div class="max-w-6xl mx-auto px-4 mb-6">
    <h2 class="text-2xl font-bold text-gradient-cyan-purple mb-2 tracking-wide">
      📅 {t('byDate', lang)}
    </h2>
    <p class="text-sm text-text-secondary font-mono">
      {t('byDateDesc', lang)}
    </p>
  </div>

  {periods.map((period) => (
    <div class="mb-8">
      <!-- Period heading -->
      <div class="max-w-6xl mx-auto px-4 mb-3">
        <h3 class="text-base font-mono font-bold text-neon-purple tracking-wide">
          {t(period.labelKey, lang)}
        </h3>
      </div>

      <!-- Papers row -->
      {period.papers.length > 0 ? (
        <div
          class="grid gap-4 max-w-3xl mx-auto px-4"
        >
          {period.papers.map((p, i) => (
            <PaperCard client:load paper={p} lang={lang} index={i} />
          ))}
        </div>
      ) : (
        <div class="max-w-6xl mx-auto px-4">
          <p class="text-text-secondary text-sm font-mono">
            {lang === 'zh' ? '暂无论文' : 'No papers'}
          </p>
        </div>
      )}
    </div>
  ))}
</section>
