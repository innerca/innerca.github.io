---
import type { Paper, Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import PaperCard from '../react/PaperCard';

export interface Props {
  papers: Paper[];
  lang: Lang;
}

const { papers, lang } = Astro.props;
---

<section class="mb-16">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-gradient-cyan-purple mb-6 tracking-wide">
      📌 {t('latest', lang)}
    </h2>
  </div>

  <div class="grid gap-4 max-w-3xl mx-auto px-4">
    {papers.map((p, i) => (
      <PaperCard client:load paper={p} lang={lang} index={i} />
    ))}
  </div>
</section>
