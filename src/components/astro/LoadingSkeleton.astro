---
export interface Props {
  count?: number;
}
---

<div class="grid gap-4">
  {Array.from({ length: Astro.props.count ?? 3 }).map(() => (
    <div class="panel-glass rounded-xl p-5 animate-pulse">
      <div class="h-5 bg-white/5 rounded w-3/4 mb-3"></div>
      <div class="h-3 bg-white/5 rounded w-full mb-2"></div>
      <div class="h-3 bg-white/5 rounded w-5/6 mb-4"></div>
      <div class="flex gap-2">
        <div class="h-5 bg-white/5 rounded-full w-16"></div>
        <div class="h-5 bg-white/5 rounded-full w-20"></div>
      </div>
    </div>
  ))}
</div>
