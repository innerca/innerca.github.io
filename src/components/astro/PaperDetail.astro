---
import fs from 'node:fs';
import path from 'node:path';
import type { Paper, Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import { getPaperSources, getExternalUrl } from '../../lib/source';
import { formatDateWithRelative } from '../../lib/date';
import TagBadge from './TagBadge.astro';
import NeonButton from './NeonButton.astro';
import SourceBadge from './SourceBadge.astro';

export interface Props {
  paper: Paper;
  lang: Lang;
}

const { paper, lang } = Astro.props;
const title = paper.title[lang];
const summary = paper.summary[lang];
const corePoints = paper.core_points[lang];
const allSources = getPaperSources(paper);
const externalUrl = getExternalUrl(paper);
const addedDate = paper.addedDate ? formatDateWithRelative(paper.addedDate, lang) : null;
const authors = paper.authors ?? [];

// Load heat score from generated data (if available)
let heatScore: number | null = null;
try {
  const heatPath = path.resolve('src/data/paper_heat_scores.json');
  if (fs.existsSync(heatPath)) {
    const raw = fs.readFileSync(heatPath, 'utf-8');
    const data = JSON.parse(raw);
    const match = (data.papers ?? []).find((p: any) => p.paper_id === paper.id);
    if (match?.heat_score != null) heatScore = match.heat_score;
  }
} catch {} // graceful fallback

function slugify(name) {
  return name
    .toLowerCase()
    .replace(/['']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
---

<article class="max-w-3xl mx-auto px-4 py-8">
  <!-- Back link -->
  <a
    href={`/${lang}`}
    class="inline-flex items-center text-text-secondary hover:text-neon-cyan transition-colors mb-8 font-mono text-sm group"
  >
    <svg
      class="w-4 h-4 mr-1 transition-transform group-hover:-translate-x-1"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    {t('backToHome', lang)}
  </a>

  <!-- Title -->
  <h1 class="text-3xl md:text-4xl font-bold text-gradient-cyan-purple mb-4 leading-tight">
    {title}
  </h1>

  <!-- Authors -->
  {authors.length > 0 && (
    <p class="text-sm text-text-secondary mb-6 leading-relaxed">
      {authors.map((a, i) => (
        <span>
          {i > 0 && <span>, </span>}
          <a href={`/${lang}/author/${slugify(a.name)}`} class="hover:text-neon-cyan transition-colors">
            {a.name}
          </a>
        </span>
      ))}
    </p>
  )}

  <!-- Metadata bar: date, sources, categories, heat, cites, added -->
  <div class="panel-glass rounded-xl p-4 mb-8">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-text-secondary font-mono">
      <!-- Date -->
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {paper.date}
      </span>

      <!-- Sources -->
      <span class="flex items-center gap-1.5">
        {allSources.map(({ config }) => (
          <SourceBadge source={config} size="sm" />
        ))}
      </span>

      <!-- Categories -->
      {paper.categories && paper.categories.length > 0 && (
        <span class="flex items-center gap-1.5 flex-wrap">
          {paper.categories.map((cat) => (
            <a
              key={cat}
              href={`/${lang}/category/${cat}`}
              class="px-1.5 py-0.5 text-[10px] font-mono rounded bg-neon-purple/10 text-neon-purple/80 border border-neon-purple/20 hover:bg-neon-purple/20 hover:text-neon-purple transition-colors"
            >{cat}</a>
          ))}
        </span>
      )}

      <!-- Heat score -->
      {heatScore != null && (
        <span class="flex items-center gap-1" title={`Heat score: ${heatScore.toFixed(1)}`}>
          <span style={{ color: heatScore >= 60 ? '#ff6b6b' : heatScore >= 30 ? '#ffd93d' : '#4a5568' }}>
            {heatScore >= 80 ? '🔥' : heatScore >= 60 ? 'Hot' : heatScore >= 30 ? 'Warm' : 'Cool'}
          </span>
          <span>{heatScore.toFixed(0)}</span>
        </span>
      )}

      <!-- Cite count -->
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        {paper.citeCount} {t('citeCount', lang)}
      </span>

      <!-- Added date -->
      {addedDate && (
        <span class="flex items-center gap-1.5 text-xs opacity-70">
          {t('added', lang)}: {addedDate}
        </span>
      )}
    </div>
  </div>

  <!-- Core Points -->
  <div class="panel-glass rounded-xl p-6 mb-6">
    <h2 class="text-lg font-bold text-neon-cyan mb-3 font-mono tracking-wide">
      {t('detailCorePoints', lang)}
    </h2>
    <div class="text-text-primary leading-relaxed whitespace-pre-line">
      {corePoints}
    </div>
  </div>

  <!-- Abstract -->
  <div class="panel-glass rounded-xl p-6 mb-6">
    <h2 class="text-lg font-bold text-neon-purple mb-3 font-mono tracking-wide">
      {t('detailAbstract', lang)}
    </h2>
    <p class="text-text-primary leading-relaxed">
      {summary}
    </p>
  </div>

  <!-- Tags (only when AI has populated them) -->
  {paper.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-6">
      {paper.tags.map((tag) => <TagBadge tag={tag} />)}
    </div>
  )}

  <!-- Action bar -->
  <div class="panel-glass rounded-xl p-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
    <NeonButton href={externalUrl} label={t('viewOriginal', lang)} external />
  </div>
</article>
