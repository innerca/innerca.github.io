---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative py-20 md:py-28 text-center overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4">
    <h1 class="text-4xl md:text-6xl font-bold text-gradient-cyan-purple mb-4 tracking-tight">
      {t('heroTitle', lang)}
    </h1>
    <p class="text-lg md:text-xl text-text-secondary font-mono tracking-wide">
      {t('heroSubtitle', lang)}
    </p>
    <div class="mt-6 w-24 h-0.5 mx-auto bg-gradient-to-r from-neon-cyan to-neon-purple rounded-full"></div>
  </div>
</section>
