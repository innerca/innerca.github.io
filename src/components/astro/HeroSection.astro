---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import { siteConfig } from '../../config/site';

export interface Props {
  lang: Lang;
  categories: string[];
}

const { lang, categories } = Astro.props;
const topCats = categories.slice(0, 4);
---

<section class="relative pt-20 pb-12 md:pt-28 md:pb-16 text-center overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4">
    <h1 class="text-4xl md:text-6xl font-bold text-gradient-cyan-purple mb-4 tracking-tight">
      {t('heroTitle', lang)}
    </h1>
    <p class="text-lg md:text-xl text-text-secondary font-mono tracking-wide mb-8">
      {t('heroSubtitle', lang)}
    </p>

    <!-- Search CTA -->
    <a
      href={`/${lang}/search`}
      class="inline-flex items-center gap-2 px-8 py-3 text-sm font-mono font-bold
             text-neon-cyan border border-neon-cyan/50 rounded-full
             hover:bg-neon-cyan/10 hover:shadow-[0_0_20px_rgba(0,240,255,0.2)]
             transition-all duration-300 mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      {lang === 'zh' ? '搜索论文' : 'Search Papers'}
    </a>

    <!-- Quick categories -->
    {topCats.length > 0 && (
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        {topCats.map((cat) => (
          <a
            key={cat}
            href={`/${lang}/search`}
            class="px-3 py-1 text-[11px] font-mono rounded-full border border-text-secondary/20
                   text-text-secondary/70 hover:text-neon-purple hover:border-neon-purple/40
                   transition-all duration-200"
          >
            {cat}
          </a>
        ))}
      </div>
    )}

    <div class="w-24 h-0.5 mx-auto bg-gradient-to-r from-neon-cyan to-neon-purple rounded-full"></div>
  </div>
</section>
