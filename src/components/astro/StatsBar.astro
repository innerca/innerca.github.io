---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import CountUp from '../react/CountUp';

export interface Props {
  lang: Lang;
  totalPapers: number;
  newToday: number;
}

const { lang, totalPapers, newToday } = Astro.props;
---

<div class="flex justify-center gap-6 md:gap-12 mb-16">
  <div class="panel-glass rounded-xl px-6 py-4 text-center min-w-[120px]">
    <div class="text-2xl md:text-3xl font-mono font-bold text-neon-cyan">
      <CountUp client:load value={totalPapers} />
    </div>
    <div class="mt-1 text-xs text-text-secondary font-mono">{t('statsPapers', lang)}</div>
  </div>
  <div class="panel-glass rounded-xl px-6 py-4 text-center min-w-[120px]">
    <div class="text-2xl md:text-3xl font-mono font-bold text-neon-purple">
      <CountUp client:load value={newToday} />
    </div>
    <div class="mt-1 text-xs text-text-secondary font-mono">{t('statsNew', lang)}</div>
  </div>
</div>
