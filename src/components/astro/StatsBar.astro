---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import CountUp from '../react/CountUp';

export interface Props {
  lang: Lang;
  totalPapers: number;
  newThisWeek: number;
}

const { lang, totalPapers, newThisWeek } = Astro.props;
---

<div class="flex justify-center gap-8 md:gap-16 mb-12">
  <div class="panel-glass rounded-xl px-8 py-6 text-center min-w-[140px]">
    <div class="text-3xl md:text-4xl font-mono font-bold text-neon-cyan">
      <CountUp client:load value={totalPapers} />
    </div>
    <div class="mt-1 text-sm text-text-secondary font-mono">{t('statsPapers', lang)}</div>
  </div>
  <div class="panel-glass rounded-xl px-8 py-6 text-center min-w-[140px]">
    <div class="text-3xl md:text-4xl font-mono font-bold text-neon-purple">
      <CountUp client:load value={newThisWeek} />
    </div>
    <div class="mt-1 text-sm text-text-secondary font-mono">{t('statsNew', lang)}</div>
  </div>
</div>
