---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import { siteConfig } from '../../config/site';
import SearchTrigger from './SearchTrigger.astro';

export interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;
const navLinks = siteConfig.nav[lang];
const logoLabel = siteConfig.name;
const logoFirst = logoLabel.replace(/_.*$/, '');
const logoSuffix = logoLabel.replace(/^[^_]+/, '');
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[rgba(11,15,25,0.75)] backdrop-blur-md border-b border-[rgba(0,240,255,0.1)]">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${lang}`} class="font-bold text-lg tracking-wider">
      <span class="text-gradient-cyan-purple">{logoFirst}</span>
      <span class="text-neon-cyan">{logoSuffix}</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-sm font-mono transition-all duration-200 relative ${
            currentPath === link.href
              ? 'text-neon-cyan after:absolute after:bottom-[-4px] after:left-0 after:right-0 after:h-[2px] after:bg-neon-cyan after:rounded-full'
              : 'text-text-secondary hover:text-neon-cyan'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-2 ml-4 pl-4 border-l border-white/10">
        <SearchTrigger lang={lang} />
      </div>
    </div>

    <!-- Mobile: icons only -->
    <div class="flex md:hidden items-center gap-2">
      <SearchTrigger lang={lang} />
      <button class="p-2 text-text-secondary" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Spacer to offset fixed nav -->
<div class="h-16"></div>
