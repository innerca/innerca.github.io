---
import type { Lang } from '../../types/paper';
import { t } from '../../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="border-t border-white/5 mt-16 py-8 px-4 md:px-8">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="text-sm text-text-secondary">
      &copy; {new Date().getFullYear()} {t('footer', lang)}
    </div>
    <div class="flex gap-6 text-sm">
      <a
        href={`/${lang}/search`}
        class="text-text-secondary hover:text-neon-cyan transition-colors font-mono"
      >
        {t('search', lang)}
      </a>
      <a
        href="https://github.com/innerca"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-secondary hover:text-neon-cyan transition-colors font-mono"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
