---
import type { Paper, Lang } from '../../types/paper';
import { t } from '../../lib/i18n';
import PaperCard from '../react/PaperCard';

export interface Props {
  papers: Paper[];
  lang: Lang;
}

const { papers, lang } = Astro.props;
---

<section class="mb-16">
  <h2 class="text-2xl font-bold text-gradient-cyan-purple mb-6 px-4 tracking-wide">
    🔥 {t('trending', lang)}
  </h2>

  {papers.length > 0 ? (
    <div
      class="flex gap-4 overflow-x-auto pb-4 px-4 snap-x snap-mandatory scrollbar-hide
             [&::-webkit-scrollbar]:hidden"
    >
      {papers.map((p) => (
        <div class="flex-shrink-0 w-[320px] snap-start">
          <PaperCard client:load paper={p} lang={lang} />
        </div>
      ))}
    </div>
  ) : (
    <p class="text-text-secondary text-sm font-mono px-4">
      {lang === 'zh' ? '暂无趋势论文' : 'No trending papers'}
    </p>
  )}
</section>
