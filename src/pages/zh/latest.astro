---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LatestPapers from '../../components/astro/LatestPapers.astro';
import papers from '../../data/papers.json';
import type { Paper } from '../../types/paper';

const lang = 'zh';
const typedPapers = papers as Paper[];

// Only show latest day's papers (statically computed at build time)
const sorted = [...typedPapers].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const latestDate = sorted.length > 0 ? sorted[0].date : '';
const latestPapers = sorted.filter((p) => p.date === latestDate);
const remainingToday = sorted.length - latestPapers.length;
---

<BaseLayout lang={lang} title="最新论文 - AI 学术前沿雷达" currentPath="/zh/latest">
  <div class="pt-8">
    <div class="max-w-6xl mx-auto px-4 mb-2">
      <p class="text-xs text-text-secondary font-mono">
        {latestDate} &middot; {latestPapers.length} 篇
      </p>
    </div>
    <LatestPapers papers={latestPapers} lang={lang} />
    {remainingToday > 0 && (
      <div class="max-w-6xl mx-auto px-4 mt-6 text-center">
        <p class="text-sm text-text-secondary font-mono">
          还有 {remainingToday} 篇来自更早日期
        </p>
      </div>
    )}
  </div>
</BaseLayout>
