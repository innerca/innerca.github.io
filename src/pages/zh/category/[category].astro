---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PaperCard from '../../../components/react/PaperCard';
import papers from '../../../data/papers.json';
import type { Paper, Lang } from '../../../types/paper';
import { t } from '../../../lib/i18n';

interface Props {
  categoryPapers: Paper[];
}

export async function getStaticPaths() {
  const allPapers = papers as Paper[];
  const categories = [
    ...new Set(allPapers.flatMap((p) => p.categories ?? [])),
  ].sort();

  return categories.map((cat) => {
    const categoryPapers = allPapers.filter((p) => p.categories?.includes(cat));
    return {
      params: { category: cat },
      props: { categoryPapers },
    };
  });
}

const { categoryPapers } = Astro.props as Props;
const category = Astro.params.category!;
const lang: Lang = 'zh';
const sorted = [...categoryPapers].sort((a, b) => b.date.localeCompare(a.date));
const dateRange = sorted.length > 1
  ? `${sorted[sorted.length - 1].date} — ${sorted[0].date}`
  : sorted[0].date;
---

<BaseLayout lang={lang} title={`${category} - AI 论文雷达`}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <!-- Back -->
    <a
      href="/zh/search"
      class="inline-flex items-center text-text-secondary hover:text-neon-cyan transition-colors mb-8 font-mono text-sm group"
    >
      <svg class="w-4 h-4 mr-1 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {t('backToSearch', lang)}
    </a>

    <!-- Title -->
    <h1 class="text-2xl md:text-3xl font-bold text-gradient-cyan-purple mb-2 leading-tight">
      {category}
    </h1>
    <p class="text-sm text-text-secondary font-mono">
      {sorted.length} 篇论文 &middot; {dateRange}
    </p>

    <!-- Paper list -->
    <div class="grid gap-4 mt-8">
      {sorted.map((p, i) => (
        <PaperCard client:load paper={p} lang={lang} index={i} />
      ))}
    </div>
  </div>
</BaseLayout>
