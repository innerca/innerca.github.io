---
// Root route: detect browser language and redirect
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI Paper Radar</title>
</head>
<body style="background:#0b0f19; color:#e0e0e0; display:flex; align-items:center; justify-content:center; min-height:100vh; font-family:monospace;">
  <p>Redirecting...</p>
  <script>
    var lang = navigator.language || navigator.userLanguage;
    var prefix = lang.startsWith('zh') ? '/zh' : '/en';
    window.location.replace(prefix);
  </script>
</body>
</html>
