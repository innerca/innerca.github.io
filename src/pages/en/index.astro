---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/astro/HeroSection.astro';
import StatsBar from '../../components/astro/StatsBar.astro';
import TrendingSection from '../../components/astro/TrendingSection.astro';
import CategorySection from '../../components/astro/CategorySection.astro';
import { loadHeatScores } from '../../lib/heat';
import { getSiteStats } from '../../lib/stats';
import { getCategoryGroups } from '../../lib/group';
import papers from '../../data/papers.json';
import type { Paper } from '../../types/paper';

const lang = 'en';
const typedPapers = papers as Paper[];

const heatMap = loadHeatScores();
const stats = getSiteStats();
const totalPapers = stats?.totalPapers ?? typedPapers.length;

// Collect all unique categories for hero quick links
const allCategories = [...new Set(typedPapers.flatMap((p) => p.categories ?? []))].sort();

const categoryGroups = getCategoryGroups(typedPapers, heatMap, 4, 6);

const newToday = typedPapers.filter((p) => {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return new Date(p.date) >= today;
}).length;
---

<BaseLayout lang={lang} title="AI Paper Radar">
  <HeroSection lang={lang} categories={allCategories} />
  <StatsBar lang={lang} totalPapers={totalPapers} newToday={newToday} />
  <TrendingSection papers={typedPapers} lang={lang} />
  <CategorySection categories={categoryGroups} lang={lang} />
</BaseLayout>
