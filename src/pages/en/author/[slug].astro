---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PaperCard from '../../../components/react/PaperCard';
import papers from '../../../data/papers.json';
import type { Paper, Lang } from '../../../types/paper';
import { t } from '../../../lib/i18n';

interface Props {
  authorName: string;
  authorPapers: Paper[];
}

export async function getStaticPaths() {
  const slugify = (name) =>
    name
      .toLowerCase()
      .replace(/['']/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  const allPapers = papers as Paper[];

  const authorMap = new Map<string, Paper[]>();
  for (const p of allPapers) {
    for (const a of p.authors ?? []) {
      const slug = slugify(a.name);
      if (!authorMap.has(slug)) authorMap.set(slug, []);
      authorMap.get(slug)!.push(p);
    }
  }

  return [...authorMap.entries()]
    .filter(([slug, papers]) => slug.length > 0 && papers.length > 0)
    .map(([slug, authorPapers]) => {
      const authorName = authorPapers[0].authors?.find(
        (a) => slugify(a.name) === slug,
      )?.name ?? slug;
      return {
        params: { slug },
        props: { authorName, authorPapers },
      };
    });
}

const { authorName, authorPapers } = Astro.props as Props;
const lang: Lang = 'en';
const sorted = [...authorPapers].sort((a, b) => b.date.localeCompare(a.date));
const dateRange = sorted.length > 1
  ? `${sorted[sorted.length - 1].date} — ${sorted[0].date}`
  : sorted[0].date;
---

<BaseLayout lang={lang} title={`${authorName} - Paper Radar`}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <!-- Back -->
    <a
      href="/en/search"
      class="inline-flex items-center text-text-secondary hover:text-neon-cyan transition-colors mb-8 font-mono text-sm group"
    >
      <svg class="w-4 h-4 mr-1 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {t('backToSearch', lang)}
    </a>

    <!-- Title -->
    <h1 class="text-2xl md:text-3xl font-bold text-gradient-cyan-purple mb-2 leading-tight">
      {authorName}
    </h1>
    <p class="text-sm text-text-secondary font-mono">
      {sorted.length} paper{sorted.length !== 1 ? 's' : ''} &middot; {dateRange}
    </p>

    <!-- Paper list -->
    <div class="grid gap-4 mt-8">
      {sorted.map((p, i) => (
        <PaperCard client:load paper={p} lang={lang} index={i} />
      ))}
    </div>
  </div>
</BaseLayout>
