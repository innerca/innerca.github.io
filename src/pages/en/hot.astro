---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperCard from '../../components/react/PaperCard';
import { t } from '../../lib/i18n';
import { getHotPapers, loadHeatScores } from '../../lib/heat';
import { relativeDate } from '../../lib/date';
import papers from '../../data/papers.json';
import type { Paper } from '../../types/paper';

const lang = 'en';
const typedPapers = papers as Paper[];

const HOT_LIMIT = 100;
const allHot = getHotPapers(typedPapers);
const hotPapers = allHot.slice(0, HOT_LIMIT);
const remaining = allHot.length - hotPapers.length;
const heatMap = loadHeatScores();
const top3 = hotPapers.slice(0, 3);
const rest = hotPapers.slice(3);
---

<BaseLayout lang={lang} title="Hot Papers - AI Paper Radar" currentPath="/en/hot">
  <div class="pt-8 max-w-6xl mx-auto px-4">
    <!-- Header -->
    <div class="max-w-3xl mx-auto mb-8">
      <h1 class="text-3xl font-bold text-gradient-cyan-purple mb-2 tracking-wide">
        🔥 {t('hot', lang)}
      </h1>
      <p class="text-sm text-text-secondary/70 font-mono">
        {t('hotDesc', lang)}
      </p>
    </div>

    <!-- Top 3 featured -->
    {top3.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {top3.map((p, i) => {
          const score = heatMap.get(p.id);
          return (
            <a
              href={`/${lang}/paper/${p.id}`}
              class="block panel-glass rounded-xl p-6 cursor-pointer group relative overflow-hidden
                     hover:-translate-y-1.5 hover:shadow-[0_0_25px_rgba(0,240,255,0.35)]
                     transition-all duration-300"
            >
              <!-- Rank badge -->
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-xs font-bold font-mono
                  {i === 0 ? 'bg-neon-cyan/20 text-neon-cyan shadow-[0_0_8px_rgba(0,240,255,0.4)]' :
                   i === 1 ? 'bg-neon-purple/20 text-neon-purple shadow-[0_0_8px_rgba(179,71,234,0.3)]' :
                   'bg-text-secondary/10 text-text-secondary'}"
                >
                  #{i + 1}
                </span>
                <span class="text-[10px] font-mono text-text-secondary/50">{t('hotRank', lang)}</span>
              </div>

              <!-- Title -->
              <h3 class="text-lg font-bold text-text-primary group-hover:text-neon-cyan transition-colors line-clamp-2 mb-2">
                {p.title[lang]}
              </h3>

              <!-- Authors -->
              <p class="text-xs text-text-secondary/70 mb-3 truncate">
                {(p.authors ?? []).slice(0, 2).map((a) => a.name).join(', ')}
                {(p.authors ?? []).length > 2 && (
                  <span class="text-text-secondary/50"> et al.</span>
                )}
              </p>

              <!-- Heat score bar -->
              {score != null && (
                <div class="mb-3">
                  <div class="flex items-center justify-between text-[10px] font-mono text-text-secondary mb-1">
                    <span>Heat</span>
                    <span>{score.toFixed(0)}</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-text-secondary/10 overflow-hidden">
                    <div
                      class="h-full rounded-full transition-all"
                      style={{
                        width: `${Math.min(100, Math.round((score / 115) * 100))}%`,
                        background: score >= 80
                          ? 'linear-gradient(90deg, #ff6b6b, #ffd93d)'
                          : score >= 60
                          ? 'linear-gradient(90deg, #ffd93d, #00f0ff)'
                          : 'linear-gradient(90deg, #4a5568, #8892b0)',
                      }}
                    />
                  </div>
                </div>
              )}

              <!-- Meta -->
              <div class="flex items-center gap-3 text-xs text-text-secondary font-mono">
                <span>{relativeDate(p.date, lang)}</span>
                <span>📖 {p.citeCount}</span>
              </div>
            </a>
          );
        })}
      </div>
    )}

    <!-- Rest of the list -->
    {rest.length > 0 && (
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs text-text-secondary/50 font-mono uppercase tracking-wider">
            {lang === 'zh' ? `更多论文（共 ${hotPapers.length} 篇）` : `More papers (${hotPapers.length} total)`}
          </span>
          <div class="flex-1 h-px bg-text-secondary/10"></div>
        </div>
        <div class="grid gap-4">
          {rest.length > 0 ? (
            rest.map((p, i) => (
              <PaperCard client:load paper={p} lang={lang} index={i} />
            ))
          ) : (
            <p class="text-text-secondary text-sm font-mono text-center py-8">
              {t('noHotPapers', lang)}
            </p>
          )}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
