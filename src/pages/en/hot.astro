---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperCard from '../../components/react/PaperCard';
import { t } from '../../lib/i18n';
import { getHotPapers } from '../../lib/heat';
import papers from '../../data/papers.json';
import type { Paper } from '../../types/paper';

const lang = 'en';
const typedPapers = papers as Paper[];

const HOT_LIMIT = 100;
const allHot = getHotPapers(typedPapers);
const hotPapers = allHot.slice(0, HOT_LIMIT);
const remaining = allHot.length - hotPapers.length;
---

<BaseLayout lang={lang} title="Hot Papers - AI Paper Radar" currentPath="/en/hot">
  <div class="pt-8 max-w-6xl mx-auto px-4">
    <h1 class="text-2xl font-bold text-gradient-cyan-purple mb-1 tracking-wide">
      🔥 {t('hot', lang)}
    </h1>
    <p class="text-xs text-text-secondary font-mono mb-6">
      Top {hotPapers.length} by heat score{remaining > 0 ? ` · +${remaining} more` : ''}
    </p>
    <div class="grid gap-4 max-w-3xl mx-auto">
      {hotPapers.length > 0 ? (
        hotPapers.map((p, i) => (
          <PaperCard client:load paper={p} lang={lang} index={i} />
        ))
      ) : (
        <p class="text-text-secondary text-sm font-mono text-center py-8">
          {t('noHotPapers', lang)}
        </p>
      )}
    </div>
  </div>
</BaseLayout>
